		}

	Models
		{
		Ball { Ball.mod.ods; }
		Rubik { Rubik.mod.ods;}
		Floppy { Floppy.mod.ods; }
		Eraser 	{Eraser.mod.ods;}
		Ez { Ez.mod.ods;}
		Ruler { Ruler.mod.ods;}
		}

	Actors
		{
		EZCentrufuge
			{
			Graphics 
				{ 
				Node 
					{
					Node { 	position {0;-50;0; } angles { 90; 0; 0; } Model { Ez;}  }
					Node { 	position {0; 50;0; } angles { 90; 0; 0; } Model { Ez;}  }
					Node { 	position {0;0;-50; } Model { Ez;}  }
					Node { 	position {0; 0;50; } Model { Ez;}  }
					} 
				}
			Collision
				{
				Box	{ position {0;-50;0; } dimensions {120;22;120;} }
				Box	{ position {0; 50;0; } dimensions {120;22;120;} }
				Box	{ position {0;0;-50; } dimensions {120;120;22;} }
				Box	{ position {0; 0;50; } dimensions {120;120;22;} }
				} 
			}
		Ball  
			{
			Collision
				{
				Sphere
					{
					position { 0; 0; 0; }
					radius { 0.5; }
					}
				} 
			Dynamics
				{
				inertia { sphere; }

				}
			Graphics { Node { Model { Ball; } }	}
			}

		Rubik { Graphics { Node { Model { Rubik;} } } }
		Floppy { Graphics { Node { Model { Floppy; } } } }
		Eraser 	{ Graphics { Node { Model { Eraser;} } } }
		Ez { Graphics { Node { Model { Ez;} } } }
		Ruler { Graphics { Node { Model { Ruler;} } } }


		Caps { Collision { Capsule { } } }


		YPlane
			{ 
			Graphics 
				{ 
				Node 
					{ 
					Node 
						{ 
						position {0; -2; 0; } 
						orientation {0.707107;0.707107;0;0;} 
						Model { Floppy; } 
						} 
					} 
				}

			Collision 
				{
				Plane
					{
					normal { 0; 1; 0; }
					#d { 0; }
					d { 5; }
					}
				}
			}

		ZPlane
			{ 
			Graphics 
				{ 
				Node 
					{ 
					Node 
						{ 
						position {0; 0; -2; } 
						Model { Floppy; } 
						} 
					} 
				}

			Collision 
				{
				Plane
					{
					normal { 0; 0; 1; }
					d { 0; }
					}
				}
			}

		SkewPlane
			{ 
			Collision 
				{
				Plane
					{
					normal { 0; 0.707; 0.707; }
					#d { -10; }
					}
				}
			}


		}
	}

