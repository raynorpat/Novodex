	##substance SDK stuff
	Vase
		{
		#no graphics or shape: a pure substance
		
		Substance
			{
			tetFile 
				{
				fileName { "smallVase.tet"; }
				#flipXY;
				texGen{ 1; }
				}

			material 
				{
				youngMod	{50000; }
				fractureFact{1; }
				deformRadius{1; }
				fractRadius {3; }
				density		{100; }
				poissonRatio {0.33; }
				
				minDeformImp {1500; }
				impMultiply  {0.02; }
				maxFractures {4; }
				gcIterations {20; }
				}


			texture { "ci_vase.bmp"; }

			anchors
				{
				yMin { 0.1; }
				}
			}
		}
