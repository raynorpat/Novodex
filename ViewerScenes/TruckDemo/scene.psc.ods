###start car
		TruckBody
		{
			# Joint name
			name	{ body; }
			# PRS
			orientation	{ -0.707107; 0.000000; -0.707107; 0.000000; }
			#position	{ -0.090812; 2.119964; -0.342994; }
			position	{ -0.090812; 0.119964; -0.342994; }
			scale	{ 1.000000; }
			# Physical properties
			mass {220;}			
			restitution	{ 0.000000; }
			centerOfMass { 0; -0.5; 0; }  #dropped center of mass for increased fahrvergnuegen


			Control
				{
				Type { CarController; }
				#default { 1; }


				driveWheelL { wheelLBack; }
				driveWheelR { wheelRBack; }

				driveWheelFL { wheelLFront; }
				driveWheelFR { wheelRFront; }

				frontSuspBarL  { frontSuspBarL; }
