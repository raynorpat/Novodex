# intro scene script for demo


Scene
	{

	PhysStart {1;}
	PhysDuration   {120;}
	DragForce { 50; }
	gravity { 0; -9; 0; }
	#gravity { 0; 0; 0; }
	collDet { 1; }
	gridRes { 5; }

	Text
		{
		T {"kinematically controlled ez disks,"; Y{-0.7;} D{5;} S{16;} N{0.1;} }
		T {"and a ruler with animated center of mass"; Y{-0.8;} D{5;} S{16;} }
		}

	Parameters
		{
		RigidBodySDK
			{
			PENALTY_FORCE { 0.6; }
			}
		}
	


	Bodies
		{

# table 1
		Rubik
			{
			mass	{10;}				
			position {-5;1.8;1; }
			scale {0.015;}
			friction {0.5;}
			}

		Rubik
			{
			mass	{10;}				
			position {-5;2.7;1; }
			scale {0.015;}
			friction {0.5;}
			}
		Ez
			{
			name { vertPlate; }

			#mass	{0;}
			#mass	{1000;}

			mass	{1;}

			angles {90; 180; 0;}
			#position {-5; 1.2; 0.75; }
			position {-5; 0.2; 0.75; }
			friction {0.2;}
			scale {0.02;}

			Behaviors
				{
				translation { destination {-5; 5; 0.75; } speed { 0.7; }  }
				}
			}

# table 2
		Rubik
			{
			mass	{10;}				
			position {0;1.8;1; }
			scale {0.015;}
			friction {0.5;}
			}

		Rubik
			{
